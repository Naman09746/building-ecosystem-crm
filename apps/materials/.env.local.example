# ============================================================
# EcosystemRealty Environment Configuration (server + client)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# --- Supabase (client-safe: URL + anon key only) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Supabase (server-only: bypasses RLS — webhooks/system jobs) ---
# Keep this out of any NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Provider (server-only) ---
GEMINI_API_KEY=your-gemini-api-key
# Alternative name accepted by the chat route:
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# --- WhatsApp Cloud API webhook (all REQUIRED for the webhook to run) ---
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-string
WHATSAPP_APP_SECRET=meta-app-secret-for-hmac-signature-verification

# --- Meta Lead Ads webhook (all REQUIRED for the webhook to run) ---
META_LEAD_ADS_VERIFY_TOKEN=generate-a-long-random-string
META_APP_SECRET=meta-app-secret-for-hmac-signature-verification

# --- Billing webhook (REQUIRED before wiring any payment provider) ---
BILLING_WEBHOOK_SECRET=generate-a-long-random-string
# Optional provider keys — checkout returns "simulated" mode until set:
# STRIPE_SECRET_KEY=sk_live_...
# RAZORPAY_KEY_SECRET=...

# --- Observability (optional) ---
# Wire @sentry/nextjs in lib/observability/reporter.ts when an account exists:
# NEXT_PUBLIC_SENTRY_DSN=https://...

# SECURITY NOTES:
# 1. Never prefix secrets with NEXT_PUBLIC_ — those ship to browser bundles.
# 2. Webhook routes fail closed when WHATSAPP_APP_SECRET / META_APP_SECRET /
#    BILLING_WEBHOOK_SECRET are unset.
# 3. Register your WhatsApp phone_number_id / Meta page_id in the `webhook_sources`
#    table so inbound events resolve to an organization (tenant).
# 4. Apply supabase/migrations/*.sql in order — quotas & tenant defaults are
#    enforced at the DATABASE layer, not just the API.
